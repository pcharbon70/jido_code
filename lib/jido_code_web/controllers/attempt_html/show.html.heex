<.placeholder
  conn={@conn}
  flash={@flash}
  current_scope={@current_scope}
  page={@page}
  view_model={@view_model}
>
  <% trust = ReadProjectionView.trust(@projection) %>
  <Projection.trust_header
    id="attempt-workspace-trust"
    state={trust.state}
    revision={trust.revision}
    freshness={trust.freshness}
    source={trust.source}
    as_of={trust.as_of}
    completeness={trust.completeness}
  />
  <Projection.attempt_summary
    id="attempt-workspace-summary"
    state={@projection.state}
    attempt={@projection.attempt || %{}}
    retry_href={ReadProjectionView.retry_href(@page)}
  />
  <Projection.health_summary
    id="attempt-workspace-counts"
    state={@projection.state}
    title="Bounded attempt records"
    items={ReadProjectionView.attempt_count_health(@projection)}
  />
  <ReadWorkspace.bounded_collection
    id="attempt-workspace-recent"
    state={@projection.state}
    title="Recent authorized observations"
    items={ReadProjectionView.recent_attempt_items(@projection)}
    empty_message="No recent authorized observations are available."
  />
  <ReadWorkspace.metadata_panel
    id="attempt-workspace-semantics"
    state={@projection.state}
    title="What this workspace means"
    items={ReadProjectionView.semantic_truth(@projection)}
  />
  <Projection.health_summary
    id="attempt-workspace-capabilities"
    state={@projection.state}
    title="Attempt capability truth"
    items={ReadProjectionView.capability_health(@projection)}
  />
</.placeholder>
