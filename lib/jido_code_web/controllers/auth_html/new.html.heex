<Layouts.app flash={@flash} frame={:content}>
  <main id="human-sign-in" class="grid min-h-full place-items-center bg-frame-canvas p-4">
    <section
      aria-labelledby="human-sign-in-title"
      class="w-full max-w-sm border-y border-border bg-background py-8"
    >
      <div class="flex items-center gap-3">
        <img src={~p"/images/logo.svg"} width="36" height="36" alt="" aria-hidden="true" />
        <div>
          <p class="text-xs font-medium uppercase text-muted-foreground">JidoCode</p>
          <h1 id="human-sign-in-title" class="mt-1 text-xl font-semibold">Sign in</h1>
        </div>
      </div>

      <p class="mt-4 text-sm leading-6 text-muted-foreground">
        Authenticate to enter the repository factory control plane.
      </p>

      <p
        :if={@notice}
        id="human-sign-in-notice"
        role="status"
        class="mt-4 border-l-2 border-status-attention bg-muted px-3 py-2 text-sm"
      >
        {@notice}
      </p>

      <p
        :if={!@capabilities.enabled}
        id="human-sign-in-unconfigured"
        role="status"
        class="mt-4 border-l-2 border-status-attention bg-muted px-3 py-2 text-sm"
      >
        Named-human authentication is not configured. Contact the service operator.
      </p>

      <div
        :if={@error}
        id="human-sign-in-error"
        role="alert"
        class="mt-4 border-l-2 border-status-failure bg-muted px-3 py-2 text-sm"
      >
        {@error}
      </div>

      <.form
        :if={@capabilities.enabled}
        for={@form}
        id="human-sign-in-form"
        action={~p"/sign-in"}
        class="mt-6 grid gap-4"
      >
        <.input
          field={@form[:login]}
          type="text"
          label="Account"
          autocomplete="username"
          required
        />
        <.input
          field={@form[:credential]}
          type="password"
          label="Credential"
          autocomplete="current-password"
          required
        />
        <input type="hidden" name={@form[:return_to].name} value={@form[:return_to].value} />
        <UI.button id="human-sign-in-submit" type="submit">
          <.icon name="hero-arrow-right-end-on-rectangle" class="size-4" /> Sign in
        </UI.button>
      </.form>

      <p class="mt-6 text-sm">
        <.link id="human-recovery-link" href={~p"/recovery"}>Account recovery</.link>
      </p>
    </section>
  </main>
</Layouts.app>
