<.placeholder
  conn={@conn}
  flash={@flash}
  current_scope={@current_scope}
  page={@page}
  view_model={@view_model}
>
  <% trust = ReadProjectionView.trust(@projection) %>
  <Projection.trust_header
    id="project-catalog-trust"
    state={trust.state}
    revision={trust.revision}
    freshness={trust.freshness}
    source={trust.source}
    as_of={trust.as_of}
    completeness={trust.completeness}
  />
  <Projection.fleet_project_table
    id="project-catalog"
    state={@projection.state}
    title="Authorized projects"
    caption="Authorized repository-backed projects"
    rows={@projection.projects}
    sort_column={ReadProjectionView.sort_column(@projection)}
    sort_direction={ReadProjectionView.sort_direction(@projection)}
    sort_hrefs={ReadProjectionView.sort_hrefs(@projection)}
    page={@projection.pagination.page}
    page_count={@projection.pagination.page_count}
    previous_href={@projection.pagination.previous_href}
    next_href={@projection.pagination.next_href}
    page_summary={@projection.pagination.summary}
    retry_href={ReadProjectionView.retry_href(@page)}
  />
</.placeholder>
