<.placeholder
  conn={@conn}
  flash={@flash}
  current_scope={@current_scope}
  page={@page}
  view_model={@view_model}
>
  <% trust = ReadProjectionView.trust(@projection) %>
  <Projection.trust_header
    id="project-dependencies-trust"
    state={trust.state}
    revision={trust.revision}
    freshness={trust.freshness}
    source={trust.source}
    as_of={trust.as_of}
    completeness={trust.completeness}
  />
  <ReadWorkspace.bounded_collection
    id="project-dependencies"
    state={@projection.state}
    title="Exact-snapshot dependencies"
    items={ReadProjectionView.dependency_items(@projection)}
    empty_message="Dependency analysis is not composed for the current exact source snapshot."
    retry_href={ReadProjectionView.retry_href(@page)}
  />
  <Projection.health_summary
    id="project-dependency-capabilities"
    state={@projection.state}
    title="Dependency capability truth"
    items={ReadProjectionView.capability_health(@projection)}
  />
</.placeholder>
