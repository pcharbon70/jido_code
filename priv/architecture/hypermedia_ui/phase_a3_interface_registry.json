  "signal_namespaces": [
    {"id": "local_presentation", "prefix": "_ui", "allowed": ["disclosure", "focus_intent", "tab_id", "theme_preference"], "authority": false},
    {"id": "factory", "prefix": "factory", "allowed": ["filter", "sort", "cursor", "search"], "authority": false},
    {"id": "project", "prefix": "project", "allowed": ["filter", "sort", "cursor", "selected_ref"], "authority": false},
    {"id": "attempt", "prefix": "attempt", "allowed": ["timeline_cursor", "conversation_cursor", "selected_ref", "draft_text"], "authority": false},
    {"id": "wiki", "prefix": "wiki", "allowed": ["filter", "search", "cursor", "selected_ref"], "authority": false},
    {"id": "lens", "prefix": "lens", "allowed": ["lens_key", "filter", "sort", "cursor", "selected_ref", "expansion_request"], "authority": false}
  ],
  "prohibited_signal_fields": [
    "actor", "account", "role", "tenant_authority", "project_authority", "graph", "query", "command", "profile", "policy", "fence", "trusted_revision", "csrf", "secret", "permission", "durable_result"
  ],
  "patch_roots": [
    "hui-factory-attention",
    "hui-factory-health",
    "hui-factory-fleet",
    "hui-project-summary",
    "hui-project-attempts",
    "hui-attempt-workspace",
    "hui-attempt-conversation",
    "hui-command-receipt",
    "hui-wiki-content",
    "hui-lens-results",
    "hui-incident-state"
  ],
  "safe_outcomes": [
    "ready", "empty", "stale", "incomplete", "contradicted", "truncated",
    "concealed_not_found", "redacted", "denied", "unavailable", "maintenance",
    "recovery", "step_up_required", "conflict", "unknown_outcome", "upgrade_required"
  ],
  "reauthorization_points": [
    "before_response_start",
    "before_query_execution",
    "before_field_shaping",
    "before_stream_subscription",
    "before_each_protected_patch",
    "before_command_construction",
    "inside_command_gateway",
    "before_approval_commit",
    "before_export_creation",
    "before_each_export_or_download_retrieval"
  ],
  "trusted_identity_authority_builder": {
    "interface": "hui.identity_scope.v1",
    "trusted_inputs": [
      "authenticated_principal_and_session",
      "current_session_and_revocation_generations",
      "server_resolved_tenant_project_resource_and_environment",
      "current_graph_grants_and_exact_optional_delegation",
      "classification_and_assurance",
      "policy_and_graph_revisions",
      "incident_posture_and_fence_when_applicable"
    ],
    "outputs": ["current_scope", "product_identity", "authority", "safe_reason_vocabulary"],
    "rejects": ["browser_actor", "browser_role", "browser_scope", "browser_grant", "browser_delegation", "browser_revision", "browser_fence", "cached_permission"]
  },
  "stream_contract": {
    "interface": "hui.stream.v1",
    "maximum_lifetime_seconds": 900,
    "maximum_reauthorization_interval_seconds": 60,
    "heartbeat_interval_seconds": 15,
    "maximum_idle_seconds": 120,
    "initial_state": "current_authorized_snapshot",
    "revocation_sources": ["account", "session", "role", "delegation", "project", "tenant", "graph", "incident"],
    "before_patch": "reauthorize_and_requery",
    "terminal_actions": ["best_effort_concealed_replacement", "close_stream", "suppress_privileged_reconnect", "clear_privileged_browser_state", "record_safe_audit_evidence"]
  },
  "command_contract": {
    "interface": "hui.command_adapter.v1",
    "preview_fields": ["action", "target", "project", "environment", "parameters", "consequence", "candidate", "blast_radius", "reversibility", "policy", "expected_revisions", "fence", "expiry", "action_digest"],
    "submit_fields": ["csrf", "current_identity", "current_assurance", "idempotency_key", "expected_state", "expected_revisions", "fence", "profile", "bounded_reason"],
    "receipt_outcomes": ["committed", "idempotent_duplicate", "conflict", "rejected", "stale_or_revoked", "unknown_outcome"],
    "recovery_states": ["unknown", "staged", "committed", "rejected", "superseded", "inaccessible"],
    "optimistic_success": false
  },
  "export_incident_audit_contract": {
    "export": "creation_and_every_retrieval_reauthorize_exact_scope_revision_classification_expiry_and_generation",
    "incident": "read_only_until_each_closed_route_has_semantic_capability_gateway_receipt_recovery_and_audit",
    "audit": "append_only_classified_receipt_and_security_evidence_separate_from_operational_telemetry",
    "offline_limit": "cannot_erase_prior_delivered_bytes"
  },
  "compatibility": {
    "additive": "optional_output_ignored_safely_without_boundary_or_default_change",
    "breaking": "required_field_route_method_meaning_state_authorization_patch_signal_or_default_change",
    "old_reader": "last_compatible_representation_or_upgrade_required_or_unavailable",
    "feature_flags": "trusted_server_rollout_selects_one_owner_before_admission",
    "dual_write": "prohibited",
    "dual_read": "prohibited_for_browser_authority; shadow_only_for_same_input_read_only_evidence",
    "deprecation": "all_consumers_named_compatible_and_observed_before_removal",
    "deprecation_window": "two_consecutive_accepted_release_manifests_plus_closed_rollback_observation_window"
  },
  "parallel_ownership": [
    {"milestone": "HUI-A", "owns": ["architecture_documents", "interface_manifests", "evidence_schema"]},
    {"milestone": "HUI-B", "owns": ["dependency_pins", "asset_digests", "consumer_spike", "component_facade_qualification"]},
    {"milestone": "HUI-C", "owns": ["identity_composition", "page_routes", "shell", "read_projections"]},
    {"milestone": "HUI-D", "owns": ["signal_schemas", "fragment_routes", "stream_route", "delivery_coordinator"]},
    {"milestone": "HUI-E", "owns": ["attempt_actions", "command_preview", "receipts", "recovery"]},
    {"milestone": "HUI-F", "owns": ["lens_registry", "lens_routes", "wiki_adapters"]},
    {"milestone": "HUI-G", "owns": ["incident", "audit_export", "security_accessibility_usability_load_proxy_release_evidence"]},
    {"milestone": "HUI-H", "owns": ["final_route_socket_runtime_dependency_asset_test_and_document_removal"]}
  ],
