jfes:ReviewerProperty a sh:PropertyShape ; sh:path jfe:reviewer ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jf:Actor ; sh:nodeKind sh:IRI .
jfes:BlindedProperty a sh:PropertyShape ; sh:path jfe:blinded ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:hasValue true .

jfes:AdjudicationShape
  a sh:NodeShape ;
  sh:targetClass jfe:Adjudication ;
