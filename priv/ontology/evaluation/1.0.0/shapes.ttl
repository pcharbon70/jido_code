    jfes:EndedAtProperty ;
  sh:sparql jfes:NoMeasurementAuthorityConstraint .

jfes:AdjudicatesTrialProperty a sh:PropertyShape ; sh:path jfe:adjudicatesTrial ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jfe:EvaluationTrial ; sh:nodeKind sh:IRI .
jfes:ConsideredResultProperty a sh:PropertyShape ; sh:path jfe:consideredResult ; sh:minCount 1 ; sh:class prov:Entity ; sh:nodeKind sh:IRI .
jfes:AdjudicationVerdictProperty a sh:PropertyShape ; sh:path jfe:adjudicationVerdict ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI .
jfes:AdjudicatorProperty a sh:PropertyShape ; sh:path prov:wasAssociatedWith ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI .

jfes:MetricObservationShape
  a sh:NodeShape ;
