jfes:AnalysisRevisionProperty a sh:PropertyShape ; sh:path jfe:analysisRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
jfes:FrozenInclusionDigestProperty a sh:PropertyShape ; sh:path jfe:frozenInclusionDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-f0-9]{64}$" .
jfes:ContainsMetricProperty a sh:PropertyShape ; sh:path jfe:containsMetric ; sh:minCount 1 ; sh:class jfe:MetricObservation ; sh:nodeKind sh:IRI .

jfes:EvaluationEvidenceBundleShape
