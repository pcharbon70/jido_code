# Cross-resource authority constraints

jfes:RunGraphStateConstraint
  a sh:SPARQLConstraint ;
  sh:message "An open evaluation-run graph must be building; a closed run must be complete or incomplete." ;
  sh:select """
    SELECT $this
    WHERE {
      $this <https://jido.run/ontology/factory#lifecycleState> ?lifecycle ;
            <https://jido.run/ontology/factory#completenessState> ?completeness .
      FILTER (
        (?lifecycle = <https://jido.run/ontology/concept/Open> &&
          ?completeness != <https://jido.run/ontology/concept/Building>) ||
        (?lifecycle = <https://jido.run/ontology/concept/Closed> &&
          ?completeness NOT IN (
            <https://jido.run/ontology/concept/Complete>,
            <https://jido.run/ontology/concept/Incomplete>
          ))
      )
    }
  """ .

jfes:ReviewerPolicyConsistencyConstraint
  a sh:SPARQLConstraint ;
  sh:message "Reviewer policy must use either no resolver-backed reviewers or two blinded reviewers with a resolver." ;
  sh:select """
    SELECT $this
    WHERE {
      $this <https://jido.run/ontology/evaluation#independentReviewerCount> ?count ;
            <https://jido.run/ontology/evaluation#blindedReviewRequired> ?blinded ;
            <https://jido.run/ontology/evaluation#resolverRequired> ?resolver .
      FILTER (
        !(
          (?count = 0 && ?resolver = false) ||
          (?count = 2 && ?blinded = true && ?resolver = true)
        )
      )
    }
  """ .

jfes:FindingLocationConstraint
  a sh:SPARQLConstraint ;
  sh:message "Review line coordinates must be paired, ordered, and attached to a file." ;
  sh:select """
    SELECT $this
    WHERE {
      OPTIONAL { $this <https://jido.run/ontology/evaluation#findingFile> ?file }
      OPTIONAL { $this <https://jido.run/ontology/evaluation#findingStartLine> ?start }
      OPTIONAL { $this <https://jido.run/ontology/evaluation#findingEndLine> ?end }
      FILTER (
        (BOUND(?start) != BOUND(?end)) ||
        ((BOUND(?start) || BOUND(?end)) && !BOUND(?file)) ||
        (BOUND(?start) && BOUND(?end) && ?end < ?start)
      )
    }
  """ .

jfes:CriticalFindingReproductionConstraint
  a sh:SPARQLConstraint ;
  sh:message "A critical review finding requires an executable reproduction artifact." ;
  sh:select """
    SELECT $this
    WHERE {
      $this <https://jido.run/ontology/evaluation#findingSeverity>
        <https://jido.run/ontology/evaluation/concept/SeverityCritical> .
      FILTER NOT EXISTS {
        $this <https://jido.run/ontology/evaluation#reproductionArtifact> ?artifact .
      }
    }
  """ .

jfes:MetricBoundsConstraint
  a sh:SPARQLConstraint ;
  sh:message "Metric counts and confidence bounds must be paired and internally consistent." ;
  sh:select """
    SELECT $this
    WHERE {
      $this <https://jido.run/ontology/evaluation#metricValue> ?estimate .
      OPTIONAL { $this <https://jido.run/ontology/evaluation#numerator> ?numerator }
      OPTIONAL { $this <https://jido.run/ontology/evaluation#denominator> ?denominator }
      OPTIONAL { $this <https://jido.run/ontology/evaluation#intervalLower> ?lower }
      OPTIONAL { $this <https://jido.run/ontology/evaluation#intervalUpper> ?upper }
      FILTER (
        (BOUND(?numerator) != BOUND(?denominator)) ||
        (BOUND(?numerator) && BOUND(?denominator) && ?numerator > ?denominator) ||
        (BOUND(?lower) != BOUND(?upper)) ||
        (BOUND(?lower) && BOUND(?upper) &&
          (?lower > ?estimate || ?estimate > ?upper))
      )
    }
  """ .

jfes:NoMeasurementAuthorityConstraint
  a sh:SPARQLConstraint ;
  sh:message "Evaluation measurements cannot carry decision or transition authority." ;
  sh:select """
    SELECT $this
    WHERE {
      $this ?authorityPredicate ?value .
      VALUES ?authorityPredicate {
        <https://jido.run/ontology/factory#accepts>
        <https://jido.run/ontology/factory#rejects>
        <https://jido.run/ontology/factory#waives>
        <https://jido.run/ontology/factory#transitionSubject>
        <https://jido.run/ontology/evaluation#rolloutDisposition>
      }
    }
  """ .

jfes:EvidenceSupportOrContradictionConstraint
  a sh:SPARQLConstraint ;
  sh:message "An evaluation evidence bundle must support or contradict at least one resource." ;
  sh:select """
    SELECT $this
    WHERE {
      FILTER NOT EXISTS {
        { $this <https://jido.run/ontology/factory#supports> ?resource }
        UNION
        { $this <https://jido.run/ontology/factory#contradicts> ?resource }
      }
    }
  """ .
