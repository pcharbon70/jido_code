@prefix jf: <https://jido.run/ontology/factory#> .
@prefix jfc: <https://jido.run/ontology/concept/> .
@prefix jfe: <https://jido.run/ontology/evaluation#> .
@prefix jfec: <https://jido.run/ontology/evaluation/concept/> .
@prefix jfes: <https://jido.run/ontology/evaluation/shapes#> .
@prefix jfs: <https://jido.run/ontology/shapes#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://jido.run/ontology/evaluation/shapes/1.0.0>
  a sh:ShapesGraph ;
  owl:imports <https://jido.run/ontology/shapes/1.0.0> ;
  jf:shapeVersion "1.0.0" ;
  rdfs:comment "Candidate closed-world constraints for Jido evaluation catalog, run, evidence, aggregate, decision, and protected-reference resources. Operational admission also applies the imported factory shapes and executable registry contract." .

# Reusable property shapes

jfes:RevisionProperty a sh:PropertyShape ; sh:path jfe:revision ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:maxLength 256 .
jfes:ContentDigestProperty a sh:PropertyShape ; sh:path jf:contentDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-f0-9]{64}$" .
jfes:TrackProperty a sh:PropertyShape ; sh:path jfe:track ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jfe:EvaluationTrack ; sh:nodeKind sh:IRI .
jfes:GeneratedAtProperty a sh:PropertyShape ; sh:path prov:generatedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime .
jfes:EndedAtProperty a sh:PropertyShape ; sh:path prov:endedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime .
jfes:EligibleAsEvidenceProperty a sh:PropertyShape ; sh:path jfe:eligibleAsEvidence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean .

# Graph family contract and graph metadata shapes

jfes:GraphFamilyContractShape
  a sh:NodeShape ;
  sh:targetClass jfe:GraphFamilyContract ;
  sh:property jfes:FamilyNameProperty,
    jfes:ScopeKeyProperty,
    jfes:GraphIriTemplateProperty,
    jfes:WriterCapabilityNameProperty,
    jfes:MutabilityProperty,
    jfes:DefaultCompletenessProperty,
    jfes:RetentionPolicyProperty,
    jfes:GraphKindValueProperty,
    jfes:AllowedLinkGraphKindProperty .

jfes:FamilyNameProperty a sh:PropertyShape ; sh:path jfe:familyName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
jfes:ScopeKeyProperty a sh:PropertyShape ; sh:path jfe:scopeKey ; sh:minCount 1 ; sh:datatype xsd:string .
jfes:GraphIriTemplateProperty a sh:PropertyShape ; sh:path jfe:graphIriTemplate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
jfes:WriterCapabilityNameProperty a sh:PropertyShape ; sh:path jfe:writerCapabilityName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
jfes:MutabilityProperty a sh:PropertyShape ; sh:path jfe:mutability ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI .
jfes:DefaultCompletenessProperty a sh:PropertyShape ; sh:path jfe:defaultCompleteness ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI .
jfes:RetentionPolicyProperty a sh:PropertyShape ; sh:path jfe:retentionPolicy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI .
jfes:GraphKindValueProperty a sh:PropertyShape ; sh:path jfe:graphKindValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI .
jfes:AllowedLinkGraphKindProperty a sh:PropertyShape ; sh:path jfe:allowsLinkToGraphKind ; sh:minCount 1 ; sh:nodeKind sh:IRI .

jfes:GraphPlacementRuleShape
  a sh:NodeShape ;
  sh:targetClass jfe:GraphPlacementRule ;
  sh:property jfes:PlacedClassProperty,
    jfes:AllowedGraphKindProperty,
    jfes:CanonicalGraphKindProperty,
    jfes:PlacementReasonProperty .

jfes:PlacedClassProperty a sh:PropertyShape ; sh:path jfe:placedClass ; sh:minCount 1 ; sh:nodeKind sh:IRI .
jfes:AllowedGraphKindProperty a sh:PropertyShape ; sh:path jfe:allowedGraphKind ; sh:minCount 1 ; sh:nodeKind sh:IRI .
jfes:CanonicalGraphKindProperty a sh:PropertyShape ; sh:path jfe:canonicalGraphKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI .
jfes:PlacementReasonProperty a sh:PropertyShape ; sh:path jfe:placementReason ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .

jfes:EvaluationCatalogFamilyContractShape
  a sh:NodeShape ;
  sh:targetNode jfe:EvaluationCatalogFamilyContract ;
  sh:property jfes:CatalogFamilyNameProperty,
    jfes:CatalogWriterCapabilityProperty,
    jfes:CatalogMutabilityProperty,
    jfes:CatalogDefaultCompletenessProperty,
    jfes:CatalogGraphKindValueProperty .

jfes:CatalogFamilyNameProperty a sh:PropertyShape ; sh:path jfe:familyName ; sh:hasValue "evaluation_catalog" .
jfes:CatalogWriterCapabilityProperty a sh:PropertyShape ; sh:path jfe:writerCapabilityName ; sh:hasValue "evaluation_catalog_writer" .
jfes:CatalogMutabilityProperty a sh:PropertyShape ; sh:path jfe:mutability ; sh:hasValue jfec:Immutable .
jfes:CatalogDefaultCompletenessProperty a sh:PropertyShape ; sh:path jfe:defaultCompleteness ; sh:hasValue jfc:Complete .
jfes:CatalogGraphKindValueProperty a sh:PropertyShape ; sh:path jfe:graphKindValue ; sh:hasValue jfec:EvaluationCatalogGraph .

jfes:EvaluationRunFamilyContractShape
  a sh:NodeShape ;
  sh:targetNode jfe:EvaluationRunFamilyContract ;
  sh:property jfes:RunFamilyNameProperty,
    jfes:RunWriterCapabilityProperty,
    jfes:RunMutabilityProperty,
    jfes:RunDefaultCompletenessProperty,
    jfes:RunGraphKindValueProperty .

jfes:RunFamilyNameProperty a sh:PropertyShape ; sh:path jfe:familyName ; sh:hasValue "evaluation_run" .
jfes:RunWriterCapabilityProperty a sh:PropertyShape ; sh:path jfe:writerCapabilityName ; sh:hasValue "evaluation_run_writer" .
jfes:RunMutabilityProperty a sh:PropertyShape ; sh:path jfe:mutability ; sh:hasValue jfec:Closeable .
jfes:RunDefaultCompletenessProperty a sh:PropertyShape ; sh:path jfe:defaultCompleteness ; sh:hasValue jfc:Building .
jfes:RunGraphKindValueProperty a sh:PropertyShape ; sh:path jfe:graphKindValue ; sh:hasValue jfec:EvaluationRunGraph .

jfes:EvaluationCatalogGraphShape
  a sh:NodeShape ;
  sh:targetClass jfe:EvaluationCatalogGraph ;
  sh:node jfs:NamedGraphShape ;
  sh:property jfes:CatalogGraphKindProperty,
    jfes:ClosedGraphLifecycleProperty,
    jfes:CompleteGraphProperty,
    jfes:CatalogRevisionProperty,
    jfes:ContentDigestProperty,
    jfes:ContainsDefinitionProperty .

jfes:CatalogGraphKindProperty a sh:PropertyShape ; sh:path jf:graphKind ; sh:hasValue jfec:EvaluationCatalogGraph .
jfes:ClosedGraphLifecycleProperty a sh:PropertyShape ; sh:path jf:lifecycleState ; sh:hasValue jfc:Closed .
jfes:CompleteGraphProperty a sh:PropertyShape ; sh:path jf:completenessState ; sh:hasValue jfc:Complete .
jfes:CatalogRevisionProperty a sh:PropertyShape ; sh:path jfe:catalogRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
jfes:ContainsDefinitionProperty a sh:PropertyShape ; sh:path jfe:containsDefinition ; sh:minCount 1 ; sh:nodeKind sh:IRI .

jfes:EvaluationRunGraphShape
  a sh:NodeShape ;
  sh:targetClass jfe:EvaluationRunGraph ;
  sh:node jfs:NamedGraphShape ;
  sh:property jfes:RunGraphKindProperty,
    jfes:RunGraphLifecycleProperty,
    jfes:RunGraphCompletenessProperty,
    jfes:DescribesRunProperty ;
  sh:sparql jfes:RunGraphStateConstraint .

jfes:RunGraphKindProperty a sh:PropertyShape ; sh:path jf:graphKind ; sh:hasValue jfec:EvaluationRunGraph .
jfes:RunGraphLifecycleProperty a sh:PropertyShape ; sh:path jf:lifecycleState ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI .
jfes:RunGraphCompletenessProperty a sh:PropertyShape ; sh:path jf:completenessState ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI .
jfes:DescribesRunProperty a sh:PropertyShape ; sh:path jfe:describesRun ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jfe:EvaluationRun ; sh:nodeKind sh:IRI .

# Catalog definition shapes

jfes:EvaluationProfileShape
  a sh:NodeShape ;
  sh:targetClass jfe:EvaluationProfile ;
  sh:property jfes:RevisionProperty,
    jfes:ContentDigestProperty,
    jfes:TrackProperty,
    jfes:UsesTargetProperty,
    jfes:UsesCorpusProperty,
    jfes:UsesOracleProperty,
    jfes:UsesRubricProperty,
    jfes:UsesVerifierPolicyProperty,
    jfes:UsesReviewerPolicyProperty,
    jfes:UsesStatisticalPlanProperty,
    jfes:RequiresSliceProperty,
    jfes:AcceptanceStageProperty,
    jfes:TrialsPerTaskProperty .

jfes:UsesTargetProperty a sh:PropertyShape ; sh:path jfe:usesTarget ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jfe:EvaluationTarget ; sh:nodeKind sh:IRI .
jfes:UsesCorpusProperty a sh:PropertyShape ; sh:path jfe:usesCorpus ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jfe:CorpusRevision ; sh:nodeKind sh:IRI .
jfes:UsesOracleProperty a sh:PropertyShape ; sh:path jfe:usesOracle ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jfe:OracleRevision ; sh:nodeKind sh:IRI .
jfes:UsesRubricProperty a sh:PropertyShape ; sh:path jfe:usesRubric ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jfe:RubricRevision ; sh:nodeKind sh:IRI .
jfes:UsesVerifierPolicyProperty a sh:PropertyShape ; sh:path jfe:usesVerifierPolicy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jfe:VerifierPolicyRevision ; sh:nodeKind sh:IRI .
jfes:UsesReviewerPolicyProperty a sh:PropertyShape ; sh:path jfe:usesReviewerPolicy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jfe:ReviewerPolicy ; sh:nodeKind sh:IRI .
jfes:UsesStatisticalPlanProperty a sh:PropertyShape ; sh:path jfe:usesStatisticalPlan ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jfe:StatisticalPlan ; sh:nodeKind sh:IRI .
jfes:RequiresSliceProperty a sh:PropertyShape ; sh:path jfe:requiresSlice ; sh:minCount 1 ; sh:class jfe:EvaluationSliceDefinition ; sh:nodeKind sh:IRI .
jfes:AcceptanceStageProperty a sh:PropertyShape ; sh:path jfe:acceptanceStage ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; sh:maxInclusive 6 .
jfes:TrialsPerTaskProperty a sh:PropertyShape ; sh:path jfe:trialsPerTask ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:positiveInteger ; sh:minInclusive 2 ; sh:maxInclusive 50 .

jfes:EvaluationTargetShape
  a sh:NodeShape ;
  sh:targetClass jfe:EvaluationTarget ;
  sh:property jfes:ProductRevisionProperty,
    jfes:ModelProviderProperty,
    jfes:ModelIdentifierProperty,
    jfes:ModelSnapshotProperty,
    jfes:InferenceParametersDigestProperty,
    jfes:AccessModeProperty,
    jfes:AuthenticationKindProperty,
    jfes:BillingModeProperty,
    jfes:AccessProfileRevisionProperty,
    jfes:AdapterRevisionsDigestProperty,
    jfes:CliVersionProperty,
    jfes:HarnessProfileRevisionProperty,
    jfes:ToolVersionsDigestProperty,
    jfes:SandboxDigestProperty,
    jfes:ContextPolicyRevisionProperty,
    jfes:MemoryPolicyRevisionProperty,
    jfes:VerifierRevisionProperty,
    jfes:GraderRevisionProperty .

jfes:ProductRevisionProperty a sh:PropertyShape ; sh:path jfe:productRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
jfes:ModelProviderProperty a sh:PropertyShape ; sh:path jfe:modelProvider ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
jfes:ModelIdentifierProperty a sh:PropertyShape ; sh:path jfe:modelIdentifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
jfes:ModelSnapshotProperty a sh:PropertyShape ; sh:path jfe:modelSnapshot ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
jfes:InferenceParametersDigestProperty a sh:PropertyShape ; sh:path jfe:inferenceParametersDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-f0-9]{64}$" .
jfes:AccessModeProperty a sh:PropertyShape ; sh:path jfe:accessMode ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:in jfes:AccessModeValues01 .
jfes:AuthenticationKindProperty a sh:PropertyShape ; sh:path jfe:authenticationKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:in jfes:AuthenticationKindValues01 .
jfes:BillingModeProperty a sh:PropertyShape ; sh:path jfe:billingMode ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:in jfes:BillingModeValues01 .
jfes:AccessProfileRevisionProperty a sh:PropertyShape ; sh:path jfe:accessProfileRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
jfes:AdapterRevisionsDigestProperty a sh:PropertyShape ; sh:path jfe:adapterRevisionsDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-f0-9]{64}$" .
jfes:CliVersionProperty a sh:PropertyShape ; sh:path jfe:cliVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
jfes:HarnessProfileRevisionProperty a sh:PropertyShape ; sh:path jfe:harnessProfileRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
jfes:ToolVersionsDigestProperty a sh:PropertyShape ; sh:path jfe:toolVersionsDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-f0-9]{64}$" .
jfes:SandboxDigestProperty a sh:PropertyShape ; sh:path jfe:sandboxDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-f0-9]{64}$" .
jfes:ContextPolicyRevisionProperty a sh:PropertyShape ; sh:path jfe:contextPolicyRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
jfes:MemoryPolicyRevisionProperty a sh:PropertyShape ; sh:path jfe:memoryPolicyRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
jfes:VerifierRevisionProperty a sh:PropertyShape ; sh:path jfe:verifierRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
jfes:GraderRevisionProperty a sh:PropertyShape ; sh:path jfe:graderRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .

jfes:CorpusRevisionShape
  a sh:NodeShape ;
  sh:targetClass jfe:CorpusRevision ;
  sh:property jfes:RevisionProperty,
    jfes:ContentDigestProperty,
    jfes:TrackProperty,
    jfes:ContainsTaskProperty .

jfes:ContainsTaskProperty a sh:PropertyShape ; sh:path jfe:containsTask ; sh:minCount 1 ; sh:class jfe:EvaluationTask ; sh:nodeKind sh:IRI .

jfes:EvaluationTaskShape
  a sh:NodeShape ;
  sh:targetClass jfe:EvaluationTask ;
  sh:property jfes:RevisionProperty,
    jfes:TaskRepositoryProperty,
    jfes:SourceRevisionGraphProperty,
    jfes:TaskClassProperty,
    jfes:TaskRiskProperty,
    jfes:TaskPartitionProperty,
    jfes:FreshPrivateProperty,
    jfes:UsesOracleProperty,
    jfes:TaskManifestDigestProperty .

jfes:TaskRepositoryProperty a sh:PropertyShape ; sh:path jfe:taskRepository ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jf:SoftwareRepository ; sh:nodeKind sh:IRI .
jfes:SourceRevisionGraphProperty a sh:PropertyShape ; sh:path jfe:sourceRevisionGraph ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jf:NamedGraph ; sh:nodeKind sh:IRI .
jfes:TaskClassProperty a sh:PropertyShape ; sh:path jfe:taskClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:in jfes:TaskClassValues01 .
jfes:TaskRiskProperty a sh:PropertyShape ; sh:path jfe:taskRisk ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:in jfes:RiskValues01 .
jfes:TaskPartitionProperty a sh:PropertyShape ; sh:path jfe:taskPartition ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:in jfes:PartitionValues01 .
jfes:FreshPrivateProperty a sh:PropertyShape ; sh:path jfe:freshPrivate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean .
jfes:TaskManifestDigestProperty a sh:PropertyShape ; sh:path jfe:taskManifestDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-f0-9]{64}$" .

jfes:OracleRevisionShape
  a sh:NodeShape ;
  sh:targetClass jfe:OracleRevision ;
  sh:property jfes:RevisionProperty,
    jfes:ContentDigestProperty,
    jfes:ProtectedArtifactProperty .

jfes:ProtectedArtifactProperty a sh:PropertyShape ; sh:path jfe:protectedArtifact ; sh:minCount 1 ; sh:class jfe:ProtectedArtifactReference ; sh:nodeKind sh:IRI .

jfes:RubricRevisionShape
  a sh:NodeShape ;
  sh:targetClass jfe:RubricRevision ;
  sh:property jfes:RevisionProperty,
    jfes:ContentDigestProperty .

jfes:VerifierPolicyRevisionShape
  a sh:NodeShape ;
  sh:targetClass jfe:VerifierPolicyRevision ;
  sh:property jfes:RevisionProperty,
    jfes:ContentDigestProperty .

jfes:ReviewerPolicyShape
  a sh:NodeShape ;
  sh:targetClass jfe:ReviewerPolicy ;
  sh:property jfes:RevisionProperty,
    jfes:ContentDigestProperty,
    jfes:IndependentReviewerCountProperty,
    jfes:BlindedReviewRequiredProperty,
    jfes:ResolverRequiredProperty,
    jfes:DisagreementProcedureRevisionProperty ;
  sh:sparql jfes:ReviewerPolicyConsistencyConstraint .

jfes:IndependentReviewerCountProperty a sh:PropertyShape ; sh:path jfe:independentReviewerCount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; sh:maxInclusive 2 .
jfes:BlindedReviewRequiredProperty a sh:PropertyShape ; sh:path jfe:blindedReviewRequired ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean .
jfes:ResolverRequiredProperty a sh:PropertyShape ; sh:path jfe:resolverRequired ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean .
jfes:DisagreementProcedureRevisionProperty a sh:PropertyShape ; sh:path jfe:disagreementProcedureRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .

jfes:StatisticalPlanShape
  a sh:NodeShape ;
  sh:targetClass jfe:StatisticalPlan ;
  sh:property jfes:RevisionProperty,
    jfes:ContentDigestProperty,
    jfes:BinaryIntervalMethodProperty,
    jfes:ContinuousIntervalMethodProperty,
    jfes:BootstrapRevisionProperty,
    jfes:StratifiesByProperty .

jfes:BinaryIntervalMethodProperty a sh:PropertyShape ; sh:path jfe:binaryIntervalMethod ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue jfec:Wilson95 ; sh:nodeKind sh:IRI .
jfes:ContinuousIntervalMethodProperty a sh:PropertyShape ; sh:path jfe:continuousIntervalMethod ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue jfec:StratifiedBootstrap ; sh:nodeKind sh:IRI .
jfes:BootstrapRevisionProperty a sh:PropertyShape ; sh:path jfe:bootstrapRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
jfes:StratifiesByProperty a sh:PropertyShape ; sh:path jfe:stratifiesBy ; sh:minCount 1 ; sh:class jfe:EvaluationSliceDefinition ; sh:nodeKind sh:IRI .

jfes:ProtectedArtifactReferenceShape
  a sh:NodeShape ;
  sh:targetClass jfe:ProtectedArtifactReference ;
  sh:closed true ;
  sh:ignoredProperties jfes:ProtectedArtifactIgnoredProperties ;
  sh:property jfes:ContentDigestProperty,
    jfes:ArtifactRoleProperty,
    jfes:AccessPolicyRevisionProperty .

jfes:ProtectedArtifactIgnoredProperties rdf:first rdf:type ; rdf:rest rdf:nil .
jfes:ArtifactRoleProperty a sh:PropertyShape ; sh:path jfe:artifactRole ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:in jfes:ArtifactRoleValues01 .
jfes:AccessPolicyRevisionProperty a sh:PropertyShape ; sh:path jfe:accessPolicyRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .

# Run and trial shapes

jfes:EvaluationRunShape
  a sh:NodeShape ;
  sh:targetClass jfe:EvaluationRun ;
  sh:property jfes:RevisionProperty,
    jfes:ContentDigestProperty,
    jfes:UsesProfileProperty,
    jfes:UsesCorpusProperty,
    jfes:UsesTargetProperty,
    jfes:FrozenAtProperty,
    jfes:RunStatusProperty,
    jfes:ProviderSeedControlProperty,
    jfes:AssignedTrialProperty .

jfes:UsesProfileProperty a sh:PropertyShape ; sh:path jfe:usesProfile ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jfe:EvaluationProfile ; sh:nodeKind sh:IRI .
jfes:FrozenAtProperty a sh:PropertyShape ; sh:path jfe:frozenAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime .
jfes:RunStatusProperty a sh:PropertyShape ; sh:path jfe:runStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:in jfes:RunStatusValues01 .
jfes:ProviderSeedControlProperty a sh:PropertyShape ; sh:path jfe:providerSeedControl ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean .
jfes:AssignedTrialProperty a sh:PropertyShape ; sh:path jfe:assignedTrial ; sh:minCount 1 ; sh:class jfe:EvaluationTrial ; sh:nodeKind sh:IRI .

jfes:EvaluationTrialShape
  a sh:NodeShape ;
  sh:targetClass jfe:EvaluationTrial ;
  sh:property jfes:ContentDigestProperty,
    jfes:InEvaluationRunProperty,
    jfes:EvaluatesTaskProperty,
    jfes:UsesProfileProperty,
    jfes:IndependentRunIndexProperty,
    jfes:TrialStatusProperty,
    jfes:ExecutionAttemptProperty .

jfes:InEvaluationRunProperty a sh:PropertyShape ; sh:path jfe:inEvaluationRun ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jfe:EvaluationRun ; sh:nodeKind sh:IRI .
jfes:EvaluatesTaskProperty a sh:PropertyShape ; sh:path jfe:evaluatesTask ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jfe:EvaluationTask ; sh:nodeKind sh:IRI .
jfes:IndependentRunIndexProperty a sh:PropertyShape ; sh:path jfe:independentRunIndex ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:positiveInteger ; sh:minInclusive 1 ; sh:maxInclusive 50 .
jfes:TrialStatusProperty a sh:PropertyShape ; sh:path jfe:trialStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:in jfes:TrialStatusValues01 .
jfes:ExecutionAttemptProperty a sh:PropertyShape ; sh:path jfe:executionAttempt ; sh:maxCount 1 ; sh:class jf:ExecutionAttempt ; sh:nodeKind sh:IRI .

jfes:TrialObservationShape
  a sh:NodeShape ;
  sh:targetClass jfe:TrialObservation ;
  sh:property jfes:OfTrialProperty,
    jfes:OutcomeProperty,
    jfes:ObservedAtProperty,
    jfes:ProvenanceCompleteProperty,
    jfes:EligibleAsEvidenceProperty .

jfes:OfTrialProperty a sh:PropertyShape ; sh:path jfe:ofTrial ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jfe:EvaluationTrial ; sh:nodeKind sh:IRI .
jfes:OutcomeProperty a sh:PropertyShape ; sh:path jfe:outcome ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:in jfes:TrialOutcomeValues01 .
jfes:ObservedAtProperty a sh:PropertyShape ; sh:path jfe:observedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime .
jfes:ProvenanceCompleteProperty a sh:PropertyShape ; sh:path jfe:provenanceComplete ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean .

# Evidence, grading, aggregation, and decision shapes

jfes:GraderResultShape
  a sh:NodeShape ;
  sh:targetClass jfe:GraderResult ;
  sh:property jfes:GradesTrialProperty,
    jfes:UsesGraderProperty,
    jfes:GraderRevisionProperty,
    jfes:ResultStatusProperty,
    jfes:InputDigestProperty,
    jfes:OutputDigestProperty,
    jfes:GeneratedAtProperty,
    jfes:EligibleAsEvidenceProperty ;
  sh:sparql jfes:NoMeasurementAuthorityConstraint .

jfes:GradesTrialProperty a sh:PropertyShape ; sh:path jfe:gradesTrial ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jfe:EvaluationTrial ; sh:nodeKind sh:IRI .
jfes:UsesGraderProperty a sh:PropertyShape ; sh:path jfe:usesGrader ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jfe:Grader ; sh:nodeKind sh:IRI .
jfes:ResultStatusProperty a sh:PropertyShape ; sh:path jfe:resultStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:in jfes:GradeVerdictValues01 .
jfes:InputDigestProperty a sh:PropertyShape ; sh:path jfe:inputDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-f0-9]{64}$" .
jfes:OutputDigestProperty a sh:PropertyShape ; sh:path jfe:outputDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-f0-9]{64}$" .

jfes:ReviewFindingShape
  a sh:NodeShape ;
  sh:targetClass jfe:ReviewFinding ;
  sh:node jfs:ClaimShape ;
  sh:property jfes:ReportedInTrialProperty,
    jfes:EvaluatedSourceRevisionGraphProperty,
    jfes:FindingFileProperty,
    jfes:FindingStartLineProperty,
    jfes:FindingEndLineProperty,
    jfes:FindingCategoryProperty,
    jfes:FindingSeverityProperty,
    jfes:ClaimTextProperty,
    jfes:ImpactProperty,
    jfes:EvidenceReferenceProperty,
    jfes:ConfidenceValueProperty,
    jfes:MatchStateProperty ;
  sh:sparql jfes:FindingLocationConstraint,
    jfes:CriticalFindingReproductionConstraint,
    jfes:NoMeasurementAuthorityConstraint .

jfes:ReportedInTrialProperty a sh:PropertyShape ; sh:path jfe:reportedInTrial ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jfe:EvaluationTrial ; sh:nodeKind sh:IRI .
jfes:EvaluatedSourceRevisionGraphProperty a sh:PropertyShape ; sh:path jfe:evaluatedSourceRevisionGraph ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jf:NamedGraph ; sh:nodeKind sh:IRI .
jfes:FindingFileProperty a sh:PropertyShape ; sh:path jfe:findingFile ; sh:maxCount 1 ; sh:datatype xsd:string .
jfes:FindingStartLineProperty a sh:PropertyShape ; sh:path jfe:findingStartLine ; sh:maxCount 1 ; sh:datatype xsd:positiveInteger .
jfes:FindingEndLineProperty a sh:PropertyShape ; sh:path jfe:findingEndLine ; sh:maxCount 1 ; sh:datatype xsd:positiveInteger .
jfes:FindingCategoryProperty a sh:PropertyShape ; sh:path jfe:findingCategory ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jfe:ReviewFindingCategory ; sh:nodeKind sh:IRI .
jfes:FindingSeverityProperty a sh:PropertyShape ; sh:path jfe:findingSeverity ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:in jfes:FindingSeverityValues01 .
jfes:ClaimTextProperty a sh:PropertyShape ; sh:path jfe:claimText ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
jfes:ImpactProperty a sh:PropertyShape ; sh:path jfe:impact ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string .
jfes:EvidenceReferenceProperty a sh:PropertyShape ; sh:path jfe:evidenceReference ; sh:minCount 1 ; sh:class prov:Entity ; sh:nodeKind sh:IRI .
jfes:ConfidenceValueProperty a sh:PropertyShape ; sh:path jf:confidenceValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 1 .
jfes:MatchStateProperty a sh:PropertyShape ; sh:path jfe:matchState ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:in jfes:FindingMatchStateValues01 .

jfes:AnalysisClaimShape
  a sh:NodeShape ;
  sh:targetClass jfe:AnalysisClaim ;
  sh:node jfs:ClaimShape ;
  sh:property jfes:ReportedInTrialProperty,
    jfes:EvaluatedSourceRevisionGraphProperty,
    jfes:ClaimTypeProperty,
    jfes:PolarityProperty,
    jfes:InferenceKindProperty,
    jfes:ClaimTextProperty,
    jfes:EvidenceReferenceProperty,
    jfes:ConfidenceValueProperty ;
  sh:sparql jfes:NoMeasurementAuthorityConstraint .

jfes:ClaimTypeProperty a sh:PropertyShape ; sh:path jfe:claimType ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jfe:AnalysisClaimType ; sh:nodeKind sh:IRI .
jfes:PolarityProperty a sh:PropertyShape ; sh:path jfe:polarity ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:in jfes:ClaimPolarityValues01 .
jfes:InferenceKindProperty a sh:PropertyShape ; sh:path jfe:inferenceKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:in jfes:InferenceKindValues01 .

jfes:HumanGradeShape
