jfec:Advance a skos:Concept ; skos:inScheme jfec:RolloutDispositionScheme ; skos:prefLabel "advance" .
jfec:Hold a skos:Concept ; skos:inScheme jfec:RolloutDispositionScheme ; skos:prefLabel "hold" .
jfec:Rollback a skos:Concept ; skos:inScheme jfec:RolloutDispositionScheme ; skos:prefLabel "rollback" .
jfec:Disable a skos:Concept ; skos:inScheme jfec:RolloutDispositionScheme ; skos:prefLabel "disable" .

jfec:ProductionSignalScheme a skos:ConceptScheme ; skos:prefLabel "production signal" .
jfec:PostPublicationCIPassed a skos:Concept ; skos:inScheme jfec:ProductionSignalScheme ; skos:prefLabel "post-publication CI passed" .
jfec:PostPublicationCIFailed a skos:Concept ; skos:inScheme jfec:ProductionSignalScheme ; skos:prefLabel "post-publication CI failed" .
jfec:Reverted a skos:Concept ; skos:inScheme jfec:ProductionSignalScheme ; skos:prefLabel "reverted" .
jfec:Incident a skos:Concept ; skos:inScheme jfec:ProductionSignalScheme ; skos:prefLabel "incident" .
jfec:Regression a skos:Concept ; skos:inScheme jfec:ProductionSignalScheme ; skos:prefLabel "regression" .
jfec:HumanOverride a skos:Concept ; skos:inScheme jfec:ProductionSignalScheme ; skos:prefLabel "human override" .

jfe:GraderResult rdfs:comment "No GraderResult, HumanGrade, Adjudication, AggregateResult, or MetricObservation has transition authority. A separate jfe:RolloutDecision must cite an admitted jf:EvidenceBundle and jf:decisionAuthority." .
