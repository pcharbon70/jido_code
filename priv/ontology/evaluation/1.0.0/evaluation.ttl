@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix jf: <https://jido.run/ontology/factory#> .
@prefix jfc: <https://jido.run/ontology/concept/> .
@prefix jfe: <https://jido.run/ontology/evaluation#> .
@prefix jfec: <https://jido.run/ontology/evaluation/concept/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://jido.run/ontology/evaluation/1.0.0>
  a owl:Ontology ;
  owl:versionIRI <https://jido.run/ontology/evaluation/1.0.0> ;
  owl:versionInfo "1.0.0" ;
  owl:imports <https://jido.run/ontology/factory/1.0.0> ,
    <http://www.w3.org/ns/prov-o> ,
    <http://www.w3.org/2004/02/skos/core> ,
    <http://purl.org/dc/terms/> ;
  dcterms:issued "2026-08-18"^^xsd:date ;
  dcterms:title "Jido coding-agent evaluation graph ontology" ;
  rdfs:comment "Candidate vocabulary for immutable evaluation definitions, closeable evaluation runs, admitted evidence, governed rollout decisions, and production outcomes. Importing this ontology does not register a graph family or grant write authority." .

# Graph topology and registry contracts

jfe:GraphFamilyContract a owl:Class ;
  rdfs:subClassOf prov:Plan ;
  rdfs:label "graph family contract" ;
  rdfs:comment "Declarative proposal for a graph family. The executable GraphRegistry remains the authority after an explicit release." .

jfe:GraphPlacementRule a owl:Class ;
  rdfs:subClassOf prov:Plan ;
  rdfs:label "graph placement rule" ;
  rdfs:comment "Declares the candidate named-graph kinds in which a resource class may be asserted. Operational class placement remains an executable shape-catalog decision." .

jfe:EvaluationCatalogGraph a owl:Class ;
  rdfs:subClassOf jf:NamedGraph ;
  rdfs:label "evaluation catalog graph" ;
  rdfs:comment "An immutable graph containing one versioned release of evaluation definitions and protected-artifact references." .

jfe:EvaluationRunGraph a owl:Class ;
  rdfs:subClassOf jf:NamedGraph ;
  rdfs:label "evaluation run graph" ;
  rdfs:comment "A graph containing one frozen evaluation run and its trials; it is appendable while building and immutable after closure." .

jfe:familyName a owl:DatatypeProperty ;
  rdfs:domain jfe:GraphFamilyContract ;
  rdfs:range xsd:string ;
  rdfs:label "family name" .

jfe:scopeKey a owl:DatatypeProperty ;
  rdfs:domain jfe:GraphFamilyContract ;
  rdfs:range xsd:string ;
  rdfs:label "scope key" .

jfe:graphIriTemplate a owl:DatatypeProperty ;
  rdfs:domain jfe:GraphFamilyContract ;
  rdfs:range xsd:string ;
  rdfs:label "graph IRI template" .

jfe:writerCapabilityName a owl:DatatypeProperty ;
  rdfs:domain jfe:GraphFamilyContract ;
  rdfs:range xsd:string ;
  rdfs:label "writer capability name" .

jfe:mutability a owl:ObjectProperty ;
  rdfs:domain jfe:GraphFamilyContract ;
  rdfs:range skos:Concept ;
  rdfs:label "mutability" .

jfe:defaultCompleteness a owl:ObjectProperty ;
  rdfs:domain jfe:GraphFamilyContract ;
  rdfs:range skos:Concept ;
  rdfs:label "default completeness" .

jfe:retentionPolicy a owl:ObjectProperty ;
  rdfs:domain jfe:GraphFamilyContract ;
  rdfs:range skos:Concept ;
  rdfs:label "retention policy" .

jfe:graphKindValue a owl:ObjectProperty ;
  rdfs:domain jfe:GraphFamilyContract ;
  rdfs:range skos:Concept ;
  rdfs:label "graph kind value" .

jfe:allowsLinkToGraphKind a owl:ObjectProperty ;
  rdfs:domain jfe:GraphFamilyContract ;
  rdfs:range skos:Concept ;
  rdfs:label "allows link to graph kind" .

jfe:placedClass a owl:ObjectProperty ;
  rdfs:domain jfe:GraphPlacementRule ;
  rdfs:range owl:Class ;
  rdfs:label "placed class" .

jfe:allowedGraphKind a owl:ObjectProperty ;
  rdfs:domain jfe:GraphPlacementRule ;
  rdfs:range skos:Concept ;
  rdfs:label "allowed graph kind" .

jfe:canonicalGraphKind a owl:ObjectProperty ;
  rdfs:domain jfe:GraphPlacementRule ;
  rdfs:range skos:Concept ;
  rdfs:label "canonical graph kind" .

jfe:placementReason a owl:DatatypeProperty ;
  rdfs:domain jfe:GraphPlacementRule ;
  rdfs:range xsd:string ;
  rdfs:label "placement reason" .

jfe:catalogRevision a owl:DatatypeProperty ;
  rdfs:domain jfe:EvaluationCatalogGraph ;
  rdfs:range xsd:string ;
  rdfs:label "catalog revision" .

jfe:containsDefinition a owl:ObjectProperty ;
  rdfs:domain jfe:EvaluationCatalogGraph ;
  rdfs:range jfe:EvaluationDefinition ;
  rdfs:subPropertyOf prov:hadMember ;
  rdfs:label "contains definition" .

jfe:describesRun a owl:ObjectProperty ;
  rdfs:domain jfe:EvaluationRunGraph ;
  rdfs:range jfe:EvaluationRun ;
  rdfs:label "describes run" .

jfe:EvaluationCatalogFamilyContract
  a jfe:GraphFamilyContract ;
  jfe:familyName "evaluation_catalog" ;
  jfe:scopeKey "catalog" , "revision" ;
  jfe:graphIriTemplate "evaluation/catalog/{catalog-token}/{revision-token}" ;
  jfe:writerCapabilityName "evaluation_catalog_writer" ;
  jfe:mutability jfec:Immutable ;
  jfe:defaultCompleteness jfc:Complete ;
  jfe:retentionPolicy jfec:EvaluationDefinitionHistory ;
  jfe:graphKindValue jfec:EvaluationCatalogGraph ;
  jfe:allowsLinkToGraphKind jfc:FactoryCatalogGraph ,
    jfc:FactoryPolicyGraph ,
    jfc:SourceGraph ;
  rdfs:comment "One graph per catalog release, not one graph per profile, corpus, or task." .

jfe:EvaluationRunFamilyContract
  a jfe:GraphFamilyContract ;
  jfe:familyName "evaluation_run" ;
  jfe:scopeKey "run" ;
  jfe:graphIriTemplate "evaluation/run/{run-token}" ;
  jfe:writerCapabilityName "evaluation_run_writer" ;
  jfe:mutability jfec:Closeable ;
  jfe:defaultCompleteness jfc:Building ;
  jfe:retentionPolicy jfec:EvaluationRunHistory ;
  jfe:graphKindValue jfec:EvaluationRunGraph ;
  jfe:allowsLinkToGraphKind jfec:EvaluationCatalogGraph ,
    jfc:FactoryPolicyGraph ,
    jfc:SourceGraph ,
    jfc:RunGraph ;
  rdfs:comment "One graph per frozen evaluation run; all trial resources for that run share the graph." .

jfe:CatalogDefinitionPlacement
  a jfe:GraphPlacementRule ;
  jfe:placedClass jfe:EvaluationDefinition , jfe:ProtectedArtifactReference ;
  jfe:allowedGraphKind jfec:EvaluationCatalogGraph ;
  jfe:canonicalGraphKind jfec:EvaluationCatalogGraph ;
  jfe:placementReason "Versioned definitions and protected references close atomically with their catalog release." .

jfe:RunObservationPlacement
  a jfe:GraphPlacementRule ;
  jfe:placedClass jfe:EvaluationRun , jfe:EvaluationTrial , jfe:TrialObservation ;
  jfe:allowedGraphKind jfec:EvaluationRunGraph ;
  jfe:canonicalGraphKind jfec:EvaluationRunGraph ;
  jfe:placementReason "Raw trial assignments and observations share the lifecycle of one closeable evaluation run." .

jfe:ReviewAnalysisPlacement
  a jfe:GraphPlacementRule ;
  jfe:placedClass jfe:ReviewFinding , jfe:AnalysisClaim ;
  jfe:allowedGraphKind jfec:EvaluationRunGraph , jfc:EvidenceGraph ;
  jfe:canonicalGraphKind jfc:EvidenceGraph ;
  jfe:placementReason "Agent proposals originate in the run; only admitted and provenance-complete findings or claims become evidence." .

jfe:EvaluationEvidencePlacement
  a jfe:GraphPlacementRule ;
  jfe:placedClass jfe:GraderResult ,
    jfe:HumanGrade ,
    jfe:Adjudication ,
    jfe:EvaluatorHealth ,
    jfe:MetricObservation ,
    jfe:AggregateResult ,
    jfe:EvaluationEvidenceBundle ,
    jfe:ProductionOutcome ;
  jfe:allowedGraphKind jfc:EvidenceGraph ;
  jfe:canonicalGraphKind jfc:EvidenceGraph ;
  jfe:placementReason "Only admitted evaluation measurements and production outcomes belong to the authoritative evidence history." .

jfe:RolloutDecisionPlacement
  a jfe:GraphPlacementRule ;
  jfe:placedClass jfe:RolloutDecision ;
  jfe:allowedGraphKind jfc:EvidenceGraph ;
  jfe:canonicalGraphKind jfc:EvidenceGraph ;
  jfe:placementReason "The immutable decision and claim disposition live in evidence; accepted state transitions remain in repository control." .

# Core evaluation resources

jfe:EvaluationDefinition a owl:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "evaluation definition" .

jfe:EvaluationProfile a owl:Class ;
  rdfs:subClassOf jfe:EvaluationDefinition ;
  rdfs:label "evaluation profile" ;
  rdfs:comment "A revision-pinned target, corpus, oracle, rubric, slice, budget, and statistical contract." .

jfe:EvaluationTarget a owl:Class ;
  rdfs:subClassOf jfe:EvaluationDefinition ;
  rdfs:label "evaluation target" ;
  rdfs:comment "The complete system-under-evaluation tuple rather than a model label alone." .

jfe:CorpusRevision a owl:Class ;
  rdfs:subClassOf jfe:EvaluationDefinition, prov:Collection ;
  rdfs:label "corpus revision" .

jfe:EvaluationTask a owl:Class ;
  rdfs:subClassOf jfe:EvaluationDefinition, jf:Task ;
  rdfs:label "evaluation task" .

jfe:OracleRevision a owl:Class ;
  rdfs:subClassOf jfe:EvaluationDefinition ;
  rdfs:label "oracle revision" .

jfe:RubricRevision a owl:Class ;
  rdfs:subClassOf jfe:EvaluationDefinition ;
  rdfs:label "rubric revision" .

jfe:EvaluationPolicyRevision a owl:Class ;
  rdfs:subClassOf jfe:EvaluationDefinition, prov:Plan ;
  rdfs:label "evaluation policy revision" .

jfe:VerifierPolicyRevision a owl:Class ;
  rdfs:subClassOf jfe:EvaluationPolicyRevision ;
  rdfs:label "verifier policy revision" .

jfe:ReviewerPolicy a owl:Class ;
  rdfs:subClassOf jfe:EvaluationPolicyRevision ;
  rdfs:label "reviewer policy" .

jfe:StatisticalPlan a owl:Class ;
  rdfs:subClassOf jfe:EvaluationDefinition, prov:Plan ;
  rdfs:label "statistical plan" .

jfe:EvaluationSliceDefinition a owl:Class ;
  rdfs:subClassOf jfe:EvaluationDefinition ;
  rdfs:label "evaluation slice definition" .

jfe:EvaluationTrack a owl:Class ;
  rdfs:subClassOf jfe:EvaluationDefinition, skos:Concept ;
  rdfs:label "evaluation track" .

jfe:MetricDefinition a owl:Class ;
  rdfs:subClassOf jfe:EvaluationDefinition, skos:Concept ;
  rdfs:label "metric definition" .

jfe:ReviewFindingCategory a owl:Class ;
  rdfs:subClassOf jfe:EvaluationDefinition, skos:Concept ;
  rdfs:label "review finding category" .

jfe:AnalysisClaimType a owl:Class ;
  rdfs:subClassOf jfe:EvaluationDefinition, skos:Concept ;
  rdfs:label "analysis claim type" .

jfe:ProtectedArtifactReference a owl:Class ;
  rdfs:subClassOf jf:Artifact ;
  rdfs:label "protected artifact reference" ;
  rdfs:comment "A capability-gated digest and policy reference. Hidden tests, expected patches, secrets, and oracle bytes are not graph literals." .

jfe:EvaluationRun a owl:Class ;
  rdfs:subClassOf prov:Activity ;
  rdfs:label "evaluation run" ;
  rdfs:comment "A frozen candidate, catalog, assignment, budget, and analysis protocol executed as one evaluation unit." .

jfe:EvaluationTrial a owl:Class ;
  rdfs:subClassOf prov:Activity ;
  rdfs:label "evaluation trial" ;
  rdfs:comment "One independent execution of one task under one profile; it is a resource inside an evaluation-run graph, not a named graph." .

jfe:TrialObservation a owl:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "trial observation" .

jfe:Evaluator a owl:Class ;
  rdfs:subClassOf prov:Agent ;
  rdfs:label "evaluator" .

jfe:Grader a owl:Class ;
  rdfs:subClassOf jfe:Evaluator, prov:SoftwareAgent ;
  rdfs:label "grader" .

jfe:GraderResult a owl:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "grader result" ;
  rdfs:comment "A measurement that may be admitted as evidence; it cannot itself accept a claim or advance rollout." .

jfe:ReviewFinding a owl:Class ;
  rdfs:subClassOf jf:Finding ;
  rdfs:label "review finding" .

jfe:AnalysisClaim a owl:Class ;
  rdfs:subClassOf jf:Claim ;
  rdfs:label "analysis claim" .

jfe:HumanGrade a owl:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "human grade" .

jfe:Adjudication a owl:Class ;
  rdfs:subClassOf prov:Activity ;
  rdfs:label "adjudication" .

jfe:EvaluatorHealth a owl:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "evaluator health" .

jfe:MetricObservation a owl:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "metric observation" .

jfe:AggregateResult a owl:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "aggregate result" ;
  rdfs:comment "A reproducible aggregate with an immutable inclusion set and exact contributing trials." .

jfe:EvaluationEvidenceBundle a owl:Class ;
  rdfs:subClassOf jf:EvidenceBundle ;
  rdfs:label "evaluation evidence bundle" .

jfe:RolloutDecision a owl:Class ;
  rdfs:subClassOf jf:Decision ;
  rdfs:label "rollout decision" ;
  rdfs:comment "A governed decision that considers admitted evidence. Evaluation results do not instantiate this decision implicitly." .

jfe:ProductionOutcome a owl:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "production outcome" .

# Definition and target relationships

jfe:revision a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
  rdfs:label "revision" .

jfe:track a owl:ObjectProperty ;
  rdfs:range jfe:EvaluationTrack ;
  rdfs:label "evaluation track" .

jfe:usesProfile a owl:ObjectProperty ;
  rdfs:range jfe:EvaluationProfile ;
  rdfs:label "uses profile" .

jfe:usesTarget a owl:ObjectProperty ;
  rdfs:range jfe:EvaluationTarget ;
  rdfs:label "uses target" .

jfe:usesCorpus a owl:ObjectProperty ;
  rdfs:range jfe:CorpusRevision ;
  rdfs:label "uses corpus" .

jfe:usesOracle a owl:ObjectProperty ;
  rdfs:range jfe:OracleRevision ;
  rdfs:label "uses oracle" .

jfe:usesRubric a owl:ObjectProperty ;
  rdfs:range jfe:RubricRevision ;
  rdfs:label "uses rubric" .

jfe:usesVerifierPolicy a owl:ObjectProperty ;
  rdfs:range jfe:VerifierPolicyRevision ;
  rdfs:label "uses verifier policy" .

jfe:usesReviewerPolicy a owl:ObjectProperty ;
  rdfs:range jfe:ReviewerPolicy ;
  rdfs:label "uses reviewer policy" .

jfe:usesStatisticalPlan a owl:ObjectProperty ;
  rdfs:range jfe:StatisticalPlan ;
  rdfs:label "uses statistical plan" .

jfe:requiresSlice a owl:ObjectProperty ;
  rdfs:range jfe:EvaluationSliceDefinition ;
  rdfs:label "requires slice" .

jfe:acceptanceStage a owl:DatatypeProperty ;
  rdfs:domain jfe:EvaluationProfile ;
  rdfs:range xsd:nonNegativeInteger ;
  rdfs:label "acceptance stage" .

jfe:trialsPerTask a owl:DatatypeProperty ;
  rdfs:domain jfe:EvaluationProfile ;
  rdfs:range xsd:positiveInteger ;
  rdfs:label "trials per task" .

jfe:independentReviewerCount a owl:DatatypeProperty ;
  rdfs:domain jfe:ReviewerPolicy ;
  rdfs:range xsd:nonNegativeInteger ;
  rdfs:label "independent reviewer count" .

jfe:blindedReviewRequired a owl:DatatypeProperty ;
  rdfs:domain jfe:ReviewerPolicy ;
  rdfs:range xsd:boolean ;
  rdfs:label "blinded review required" .

jfe:resolverRequired a owl:DatatypeProperty ;
  rdfs:domain jfe:ReviewerPolicy ;
  rdfs:range xsd:boolean ;
  rdfs:label "resolver required" .

jfe:disagreementProcedureRevision a owl:DatatypeProperty ;
  rdfs:domain jfe:ReviewerPolicy ;
  rdfs:range xsd:string ;
  rdfs:label "disagreement procedure revision" .

jfe:binaryIntervalMethod a owl:ObjectProperty ;
  rdfs:domain jfe:StatisticalPlan ;
  rdfs:range skos:Concept ;
  rdfs:label "binary interval method" .

jfe:continuousIntervalMethod a owl:ObjectProperty ;
  rdfs:domain jfe:StatisticalPlan ;
  rdfs:range skos:Concept ;
  rdfs:label "continuous interval method" .

jfe:bootstrapRevision a owl:DatatypeProperty ;
  rdfs:domain jfe:StatisticalPlan ;
  rdfs:range xsd:string ;
  rdfs:label "bootstrap revision" .

jfe:stratifiesBy a owl:ObjectProperty ;
  rdfs:domain jfe:StatisticalPlan ;
  rdfs:range jfe:EvaluationSliceDefinition ;
  rdfs:label "stratifies by" .

jfe:productRevision a owl:DatatypeProperty ; rdfs:domain jfe:EvaluationTarget ; rdfs:range xsd:string ; rdfs:label "product revision" .
jfe:modelProvider a owl:DatatypeProperty ; rdfs:domain jfe:EvaluationTarget ; rdfs:range xsd:string ; rdfs:label "model provider" .
jfe:modelIdentifier a owl:DatatypeProperty ; rdfs:domain jfe:EvaluationTarget ; rdfs:range xsd:string ; rdfs:label "model identifier" .
jfe:modelSnapshot a owl:DatatypeProperty ; rdfs:domain jfe:EvaluationTarget ; rdfs:range xsd:string ; rdfs:label "model snapshot" .
jfe:inferenceParametersDigest a owl:DatatypeProperty ; rdfs:domain jfe:EvaluationTarget ; rdfs:subPropertyOf jf:contentDigest ; rdfs:range xsd:string ; rdfs:label "inference parameters digest" .
jfe:accessMode a owl:ObjectProperty ; rdfs:domain jfe:EvaluationTarget ; rdfs:range skos:Concept ; rdfs:label "access mode" .
jfe:authenticationKind a owl:ObjectProperty ; rdfs:domain jfe:EvaluationTarget ; rdfs:range skos:Concept ; rdfs:label "authentication kind" .
jfe:billingMode a owl:ObjectProperty ; rdfs:domain jfe:EvaluationTarget ; rdfs:range skos:Concept ; rdfs:label "billing mode" .
jfe:accessProfileRevision a owl:DatatypeProperty ; rdfs:domain jfe:EvaluationTarget ; rdfs:range xsd:string ; rdfs:label "access profile revision" .
jfe:adapterRevisionsDigest a owl:DatatypeProperty ; rdfs:domain jfe:EvaluationTarget ; rdfs:subPropertyOf jf:contentDigest ; rdfs:range xsd:string ; rdfs:label "adapter revisions digest" .
jfe:cliVersion a owl:DatatypeProperty ; rdfs:domain jfe:EvaluationTarget ; rdfs:range xsd:string ; rdfs:label "CLI version" .
jfe:harnessProfileRevision a owl:DatatypeProperty ; rdfs:domain jfe:EvaluationTarget ; rdfs:range xsd:string ; rdfs:label "harness profile revision" .
jfe:toolVersionsDigest a owl:DatatypeProperty ; rdfs:domain jfe:EvaluationTarget ; rdfs:subPropertyOf jf:contentDigest ; rdfs:range xsd:string ; rdfs:label "tool versions digest" .
jfe:sandboxDigest a owl:DatatypeProperty ; rdfs:domain jfe:EvaluationTarget ; rdfs:subPropertyOf jf:contentDigest ; rdfs:range xsd:string ; rdfs:label "sandbox digest" .
jfe:contextPolicyRevision a owl:DatatypeProperty ; rdfs:domain jfe:EvaluationTarget ; rdfs:range xsd:string ; rdfs:label "context policy revision" .
jfe:memoryPolicyRevision a owl:DatatypeProperty ; rdfs:domain jfe:EvaluationTarget ; rdfs:range xsd:string ; rdfs:label "memory policy revision" .
jfe:verifierRevision a owl:DatatypeProperty ; rdfs:domain jfe:EvaluationTarget ; rdfs:range xsd:string ; rdfs:label "verifier revision" .
jfe:graderRevision a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "grader revision" .

jfe:containsTask a owl:ObjectProperty ;
  rdfs:domain jfe:CorpusRevision ;
  rdfs:range jfe:EvaluationTask ;
  rdfs:subPropertyOf prov:hadMember ;
  rdfs:label "contains task" .

jfe:taskRepository a owl:ObjectProperty ;
  rdfs:domain jfe:EvaluationTask ;
  rdfs:range jf:SoftwareRepository ;
  rdfs:label "task repository" .

jfe:sourceRevisionGraph a owl:ObjectProperty ;
  rdfs:domain jfe:EvaluationTask ;
  rdfs:range jf:NamedGraph ;
  rdfs:label "source revision graph" .

jfe:taskClass a owl:ObjectProperty ; rdfs:domain jfe:EvaluationTask ; rdfs:range skos:Concept ; rdfs:label "task class" .
jfe:taskRisk a owl:ObjectProperty ; rdfs:domain jfe:EvaluationTask ; rdfs:range skos:Concept ; rdfs:label "task risk" .
jfe:taskPartition a owl:ObjectProperty ; rdfs:domain jfe:EvaluationTask ; rdfs:range skos:Concept ; rdfs:label "task partition" .
jfe:freshPrivate a owl:DatatypeProperty ; rdfs:domain jfe:EvaluationTask ; rdfs:range xsd:boolean ; rdfs:label "fresh and private" .
jfe:taskManifestDigest a owl:DatatypeProperty ; rdfs:domain jfe:EvaluationTask ; rdfs:subPropertyOf jf:contentDigest ; rdfs:range xsd:string ; rdfs:label "task manifest digest" .

jfe:protectedArtifact a owl:ObjectProperty ;
  rdfs:range jfe:ProtectedArtifactReference ;
  rdfs:label "protected artifact" .

jfe:artifactRole a owl:ObjectProperty ;
  rdfs:domain jfe:ProtectedArtifactReference ;
  rdfs:range skos:Concept ;
  rdfs:label "artifact role" .

jfe:accessPolicyRevision a owl:DatatypeProperty ;
  rdfs:domain jfe:ProtectedArtifactReference ;
  rdfs:range xsd:string ;
  rdfs:label "access policy revision" .

# Run, trial, grading, and aggregation relationships

jfe:assignedTrial a owl:ObjectProperty ;
  rdfs:domain jfe:EvaluationRun ;
  rdfs:range jfe:EvaluationTrial ;
  rdfs:label "assigned trial" .

jfe:runStatus a owl:ObjectProperty ; rdfs:domain jfe:EvaluationRun ; rdfs:range skos:Concept ; rdfs:label "run status" .
jfe:frozenAt a owl:DatatypeProperty ; rdfs:domain jfe:EvaluationRun ; rdfs:range xsd:dateTime ; rdfs:label "frozen at" .
jfe:providerSeedControl a owl:DatatypeProperty ; rdfs:domain jfe:EvaluationRun ; rdfs:range xsd:boolean ; rdfs:label "provider seed control" .

jfe:inEvaluationRun a owl:ObjectProperty ;
  rdfs:domain jfe:EvaluationTrial ;
  rdfs:range jfe:EvaluationRun ;
  rdfs:label "in evaluation run" .

jfe:evaluatesTask a owl:ObjectProperty ;
  rdfs:domain jfe:EvaluationTrial ;
  rdfs:range jfe:EvaluationTask ;
  rdfs:label "evaluates task" .

jfe:independentRunIndex a owl:DatatypeProperty ;
  rdfs:domain jfe:EvaluationTrial ;
  rdfs:range xsd:positiveInteger ;
  rdfs:label "independent run index" .

jfe:trialStatus a owl:ObjectProperty ; rdfs:domain jfe:EvaluationTrial ; rdfs:range skos:Concept ; rdfs:label "trial status" .

jfe:executionAttempt a owl:ObjectProperty ;
  rdfs:domain jfe:EvaluationTrial ;
  rdfs:range jf:ExecutionAttempt ;
  rdfs:label "execution attempt" .

jfe:ofTrial a owl:ObjectProperty ;
  rdfs:domain jfe:TrialObservation ;
  rdfs:range jfe:EvaluationTrial ;
  rdfs:label "of trial" .

jfe:outcome a owl:ObjectProperty ; rdfs:domain jfe:TrialObservation ; rdfs:range skos:Concept ; rdfs:label "outcome" .
jfe:observedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime ; rdfs:label "observed at" .
jfe:provenanceComplete a owl:DatatypeProperty ; rdfs:domain jfe:TrialObservation ; rdfs:range xsd:boolean ; rdfs:label "provenance complete" .
jfe:eligibleAsEvidence a owl:DatatypeProperty ; rdfs:range xsd:boolean ; rdfs:label "eligible as evidence" .
jfe:outcomeReason a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "outcome reason" .
jfe:referencesArtifact a owl:ObjectProperty ; rdfs:range jf:Artifact ; rdfs:label "references artifact" .

jfe:gradesTrial a owl:ObjectProperty ; rdfs:range jfe:EvaluationTrial ; rdfs:label "grades trial" .
jfe:usesGrader a owl:ObjectProperty ; rdfs:range jfe:Grader ; rdfs:label "uses grader" .
jfe:gradedArtifact a owl:ObjectProperty ; rdfs:range jf:Artifact ; rdfs:label "graded artifact" .
jfe:resultStatus a owl:ObjectProperty ; rdfs:range skos:Concept ; rdfs:label "result status" .
jfe:inputDigest a owl:DatatypeProperty ; rdfs:subPropertyOf jf:contentDigest ; rdfs:range xsd:string ; rdfs:label "input digest" .
jfe:outputDigest a owl:DatatypeProperty ; rdfs:subPropertyOf jf:contentDigest ; rdfs:range xsd:string ; rdfs:label "output digest" .

jfe:reviewer a owl:ObjectProperty ; rdfs:range jf:Actor ; rdfs:label "reviewer" .
jfe:blinded a owl:DatatypeProperty ; rdfs:domain jfe:HumanGrade ; rdfs:range xsd:boolean ; rdfs:label "blinded" .

jfe:reportedInTrial a owl:ObjectProperty ; rdfs:range jfe:EvaluationTrial ; rdfs:label "reported in trial" .
jfe:evaluatedSourceRevisionGraph a owl:ObjectProperty ; rdfs:range jf:NamedGraph ; rdfs:label "evaluated source revision graph" .
jfe:findingFile a owl:DatatypeProperty ; rdfs:domain jfe:ReviewFinding ; rdfs:range xsd:string ; rdfs:label "finding file" .
jfe:findingStartLine a owl:DatatypeProperty ; rdfs:domain jfe:ReviewFinding ; rdfs:range xsd:positiveInteger ; rdfs:label "finding start line" .
jfe:findingEndLine a owl:DatatypeProperty ; rdfs:domain jfe:ReviewFinding ; rdfs:range xsd:positiveInteger ; rdfs:label "finding end line" .
jfe:findingCategory a owl:ObjectProperty ; rdfs:domain jfe:ReviewFinding ; rdfs:range jfe:ReviewFindingCategory ; rdfs:label "finding category" .
jfe:findingSeverity a owl:ObjectProperty ; rdfs:domain jfe:ReviewFinding ; rdfs:range skos:Concept ; rdfs:label "finding severity" .
